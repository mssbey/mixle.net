# Nefis Aroma — ortam değişkenleri şablonu.
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` git'e girmez.

# --- Vitrin ---
# Kanonik URL, Open Graph ve site haritası için doğrulanmış alan adı.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
# Yerel görsel QA için Chrome/Chromium yolu.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- Veritabanı (Prisma) ---
# SQLite (yerel geliştirme). Yol proje köküne GÖREDİR.
DATABASE_URL="file:./data/nefis.db"
# Postgres'e geçiş: aşağıdaki satırı kullanın, prisma/schema.prisma içindeki
# datasource provider'ı "postgresql" yapın ve `npm run db:migrate` çalıştırın.
# DATABASE_URL="postgresql://kullanici:parola@host:5432/nefisaroma?schema=public"
#
# UYARI: SQLite dosyası Vercel gibi sunucusuz ortamlarda KALICI DEĞİLDİR.
# Canlıya çıkmadan önce Postgres'e geçilmelidir.

# --- Güvenlik ---
# Oturum çerezini imzalar. En az 32 karakter. Üretimde MUTLAKA değiştirin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Hassas ayarların (ödeme anahtarları, TCKN) AES-256-GCM şifrelemesi.
# 32 baytlık base64 anahtar. KAYBEDİLİRSE şifreli veriler okunamaz — yedekleyin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Çalışma modu ---
# true: ödeme sağlayıcıları test moduna zorlanır, e-postalar gerçekten
# gönderilmez (EmailLog'a yazılıp panelde gösterilir). Varsayılan: true.
DEMO_MODE=true

# --- Ödeme sağlayıcıları (F3) ---
# Anahtarlar tercihen panelden (/admin/ayarlar/odeme) girilir ve ENCRYPTION_KEY ile
# şifrelenerek veritabanında tutulur. Buradaki değerler panelde kayıt yoksa yedek
# olarak okunur. DEMO_MODE=true iken kart ödemesi her zaman mock sağlayıcıya gider.
# Webhook/dönüş adresleri NEXT_PUBLIC_SITE_URL ile üretilir:
#   /api/webhooks/payments/{iyzico|paytr|stripe}   /api/payments/{sağlayıcı}/donus
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Kargo sağlayıcıları (F4) ---
# API'si olmayan firmalar için "manuel" adaptör kullanılır; bu değerler boş kalabilir.
SHIPPING_YURTICI_USER=
SHIPPING_YURTICI_PASSWORD=
SHIPPING_ARAS_USER=
SHIPPING_ARAS_PASSWORD=

# --- E-posta (F7) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nefis Aroma <destek@nefisaroma.example>"
# veya SMTP yerine:
# RESEND_API_KEY=

# --- e-Fatura / e-Arşiv (F7) ---
EINVOICE_PROVIDER=
EINVOICE_API_KEY=
