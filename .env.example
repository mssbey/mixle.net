# Nefis Aroma — ortam değişkenleri şablonu.
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` git'e girmez.

# --- Vitrin ---
# Kanonik URL, Open Graph ve site haritası için doğrulanmış alan adı.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
# Yerel görsel QA için Chrome/Chromium yolu.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- Veritabanı (Prisma) ---
# PostgreSQL bağlantı dizesi (Neon, Vercel Postgres, Supabase vb.).
# Vercel'de proje > Storage > Create Database > Postgres (Neon) ile oluşturup
# bağlarsanız DATABASE_URL otomatik olarak proje ortam değişkenlerine eklenir.
# Yerel geliştirme için de aynı şekilde bir Postgres veritabanı gerekir (Neon'da
# ücretsiz bir "dev" branch/veritabanı oluşturup buraya yapıştırabilirsiniz).
DATABASE_URL="postgresql://kullanici:parola@host:5432/nefisaroma?schema=public"

# --- Güvenlik ---
# Oturum çerezini imzalar. En az 32 karakter. Üretimde MUTLAKA değiştirin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Hassas ayarların (ödeme anahtarları, TCKN) AES-256-GCM şifrelemesi.
# 32 baytlık base64 anahtar. KAYBEDİLİRSE şifreli veriler okunamaz — yedekleyin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Çalışma modu ---
# true: ödeme sağlayıcıları test moduna zorlanır, e-postalar gerçekten
# gönderilmez (EmailLog'a yazılıp panelde gösterilir). Varsayılan: true.
DEMO_MODE=true

# --- Ödeme sağlayıcıları (F3) ---
# Anahtarlar tercihen panelden (/admin/ayarlar/odeme) girilir ve ENCRYPTION_KEY ile
# şifrelenerek veritabanında tutulur. Buradaki değerler panelde kayıt yoksa yedek
# olarak okunur. DEMO_MODE=true iken kart ödemesi her zaman mock sağlayıcıya gider.
# Webhook/dönüş adresleri NEXT_PUBLIC_SITE_URL ile üretilir:
#   /api/webhooks/payments/{iyzico|paytr|stripe}   /api/payments/{sağlayıcı}/donus
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Kargo (F4) ---
# Taşıyıcı API anahtarları ortam değişkeni DEĞİL, panelden girilir
# (/admin/ayarlar/kargo → ENCRYPTION_KEY ile şifrelenip veritabanına yazılır).
# Bu sürümde gerçek taşıyıcı entegrasyonu yoktur (bkz. server/shipping/adapters/*
# başındaki not); takip numarası her zaman elle girilir/güncellenir.
#
# CRON_SECRET yalnızca zamanlanmış takip senkronunu (/api/cron/kargo-takip,
# scripts/sync-shipments.mts) korumak için kullanılır — rastgele bir dize:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- E-posta (F7) ---
# Tercihen panelden girilir (/admin/ayarlar/eposta → ENCRYPTION_KEY ile
# şifrelenip veritabanına yazılır). Buradaki değerler panelde kayıt yoksa
# yedek olarak okunur. DEMO_MODE=true iken hiçbiri kullanılmaz (e-postalar
# EmailLog'a yazılır, gerçekten gönderilmez).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nefis Aroma <destek@nefisaroma.example>"
# veya SMTP yerine:
# RESEND_API_KEY=

# --- e-Fatura / e-Arşiv ---
# Bu sürümde YOK — yalnızca gelecekteki entegrasyon için arayüz tanımlıdır
# (src/server/einvoice/provider.ts), hiçbir kod yolu bu değişkenleri okumaz.
# GİB onaylı bir entegratör (Logo, Foriba, Paraşüt vb.) ile ticari sözleşme
# gerektirir. Panelin ürettiği belge bilgi fişi/irsaliyedir, e-Fatura değildir.
# EINVOICE_PROVIDER=
# EINVOICE_API_KEY=
