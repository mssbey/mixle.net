# Optional: verified public domain for canonical, Open Graph and sitemap.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
# Optional: Chrome or Chromium executable for local QA.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- Admin paneli (/admin) ---
# Paylaşılan giriş parolası. Tanımsızsa "nefis-admin" kullanılır.
# Gerçek kimlik doğrulama değildir; tek kullanıcı, rol yok.
# ADMIN_PASSWORD=degistir-beni
# Üretimde katalog dosyasına yazmayı açar. Geliştirmede zaten açıktır.
# ADMIN_WRITE_ENABLED=false
